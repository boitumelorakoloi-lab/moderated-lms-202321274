<mxfile host="app.diagrams.net"><diagram id="dep" name="Deployment"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1" value="«device»&lt;br&gt;&lt;b&gt;LMS PC&lt;/b&gt; (school office or computer lab)&lt;br&gt;{CPU x86-64, 4 GB RAM, 20 GB free disk}" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=18;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="560" height="560" as="geometry"/></mxCell><mxCell id="d2" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Ubuntu 24.04 LTS&lt;/b&gt; (or Windows 10/11 for a single-user install)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=12;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;dashed=0;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="510" height="470" as="geometry"/></mxCell><mxCell id="d3" value="«artifact» &lt;b&gt;lms&lt;/b&gt;&lt;br&gt;C++17 console program (v1.0); one process per logged-in user" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="170" width="460" height="44" as="geometry"/></mxCell><mxCell id="d4" value="«artifact» &lt;b&gt;libsqlite3 3.45, libsodium 1.0.18&lt;/b&gt;&lt;br&gt;shared libraries (lms.exe + DLLs on Windows)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="230" width="460" height="44" as="geometry"/></mxCell><mxCell id="d5" value="«artifact» &lt;b&gt;lms.db  (+ lms.db-wal, lms.db-shm)&lt;/b&gt;&lt;br&gt;SQLite database, WAL mode, on the local disk only" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="460" height="44" as="geometry"/></mxCell><mxCell id="d6" value="«artifact» &lt;b&gt;submissions/&lt;/b&gt;&lt;br&gt;stored copies of submitted files (pdf, docx, txt, zip; max 10 MB)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="360" width="460" height="44" as="geometry"/></mxCell><mxCell id="d7" value="«artifact» &lt;b&gt;backups/&lt;/b&gt;&lt;br&gt;dated backup copies made by the administrator (FR-25)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="420" width="460" height="44" as="geometry"/></mxCell><mxCell id="d8" value="All lms processes open the same lms.db on the local disk. WAL mode + 5 s busy timeout let up to 20 sessions work at once (NFR-02). The database is never put on a network share (SQLite, 2024)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="490" width="460" height="70" as="geometry"/></mxCell><mxCell id="d9" value="«device»&lt;br&gt;&lt;b&gt;Lab / staff PC&lt;/b&gt;&lt;br&gt;0..20 at the same time" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=18;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="160" width="230" height="190" as="geometry"/></mxCell><mxCell id="d10" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;SSH client&lt;/b&gt;&lt;br&gt;(Windows Terminal / PuTTY)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=12;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="180" height="90" as="geometry"/></mxCell><mxCell id="d11" value="«device»&lt;br&gt;&lt;b&gt;Keyboard + screen&lt;/b&gt;&lt;br&gt;at the LMS PC" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=18;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="420" width="230" height="110" as="geometry"/></mxCell><mxCell id="d12" value="«device»&lt;br&gt;&lt;b&gt;USB backup drive&lt;/b&gt;&lt;br&gt;kept locked away by the administrator" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=18;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="320" width="240" height="140" as="geometry"/></mxCell><mxCell id="d13" value="«artifact» &lt;b&gt;lms-backup-YYYYMMDD.db&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="975" y="400" width="210" height="44" as="geometry"/></mxCell><mxCell id="d14" value="«device»&lt;br&gt;&lt;b&gt;GitHub Actions runner&lt;/b&gt; (build only)&lt;br&gt;ubuntu-24.04: build, test, analyse" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=18;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="40" width="240" height="130" as="geometry"/></mxCell><mxCell id="d15" value="«protocol» SSH over the school LAN&lt;br&gt;(no internet needed, NFR-03)" style="endArrow=none;html=1;labelBackgroundColor=#FFFFFF;rounded=0;fontFamily=Helvetica;fontSize=11;strokeColor=#000000;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="d9" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d16" value="«local console»" style="endArrow=none;html=1;labelBackgroundColor=#FFFFFF;rounded=0;fontFamily=Helvetica;fontSize=11;strokeColor=#000000;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" parent="1" source="d11" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d17" value="«USB» copy backup" style="endArrow=none;html=1;labelBackgroundColor=#FFFFFF;rounded=0;fontFamily=Helvetica;fontSize=11;strokeColor=#000000;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="d12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d18" value="«deploy» v1.0 release" style="endArrow=open;dashed=1;html=1;labelBackgroundColor=#FFFFFF;rounded=0;fontFamily=Helvetica;fontSize=11;strokeColor=#000000;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;endSize=10;exitX=0.5;exitY=1;exitDx=0;entryX=1;entryY=0.12;" edge="1" parent="1" source="d14" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>